NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only — 직원 가입신청(계정 생성) API 라우트에서만 쓴다. NEXT_PUBLIC_ 접두어를
# 붙이지 않아야 브라우저 번들에 안 들어간다.
SUPABASE_SERVICE_ROLE_KEY=

# 비대면진료 신청(구글폼 자동 전송) — 둘 다 서버 전용이다.
# REMOTE_CONSULT_INGEST_SECRET: 구글 시트 스크립트가 x-ingest-secret 헤더로 보내는 공유 비밀값(긴 무작위 글자).
# REMOTE_CONSULT_RRN_KEY: 주민번호 암호화 키(32바이트를 base64로). 잃어버리면 저장된 주민번호를 복호화할 수
#   없으니 비밀번호 관리자 등에 따로 백업한다. 만드는 법: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REMOTE_CONSULT_INGEST_SECRET=
REMOTE_CONSULT_RRN_KEY=
